# Copiá este fichero a .env.local (que está en .gitignore) y ajustá lo que haga falta.

# A dónde manda Vite las peticiones /api/* durante `npm run dev`. Solo afecta al
# servidor de desarrollo: en producción no hay proxy, porque el ALB ya reparte
# /api/* a la API y el resto a la SPA sobre el mismo origen.
VITE_API_PROXY=https://crm-dev.gopeakintelligence.com

# Prefijo que la app le pone a cada ruta de la API. Vacío = mismo origen, que es
# lo normal. Se rellena solo para apuntar a otro host sin pasar por el proxy, y
# en ese caso hace falta CORS en el backend (hoy no lo hay).
# VITE_API_BASE=