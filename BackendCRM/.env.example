# Copiar a .env para desarrollo local. En dev/prod estas variables las inyecta la
# definicion de task de ECS: las que no son secretas como `environment`, y las que
# si lo son (DATABASE_URL, JWT_SECRET) como `secrets` desde SSM.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# El rol crm_<env>_app, NUNCA el dueno crm_<env>: el dueno se salta RLS y con esa
# credencial el aislamiento por tenant no existiria.
DATABASE_URL=postgresql://crm_dev_app:CAMBIAR@localhost:5432/crm_dev

# openssl rand -hex 48   (en dev/prod sale de /gpi/<env>/crm/jwt_secret)
JWT_SECRET=cambiar-por-una-clave-de-al-menos-32-caracteres

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true

# Sin valor: activo en produccion, apagado en el resto.
DATABASE_SSL=false

# Bundle de CA de AWS RDS, para verificar el certificado del servidor cuando
# DATABASE_SSL esta activo. Va en la imagen (ver Dockerfile). Si falta, el
# proceso NO arranca: es preferible a hablar con la base sin verificar quien
# contesta.
RDS_CA_BUNDLE_PATH=./certs-rds-global.pem

# ── correo (Amazon SES) ─────────────────────────────────────────────────────
# En dev/prod la region la pone ECS; aqui se deja explicita.
AWS_REGION=eu-west-1

# Direccion verificada en SES. Obligatoria aunque EMAIL_ENABLED sea false.
EMAIL_FROM=no-responder@ejemplo.test
EMAIL_FROM_NAME=Peak Intelligence

# Base del front: de aqui salen los enlaces de invitacion y de recuperacion.
APP_BASE_URL=http://localhost:5173

# En local se deja en false: no se manda nada y el token sale por el log, que es
# la unica forma de seguir el flujo sin buzon. NO se usa z.coerce.boolean() al
# leerla, porque Boolean("false") es true y apagarla seria imposible.
EMAIL_ENABLED=false

# Opcional. Es lo que engancha rebotes y quejas a SNS/CloudWatch; si se nombra
# uno que no existe, SES rechaza el envio.
# SES_CONFIGURATION_SET=gpi-crm-dev
